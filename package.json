{
  "name": "subscription-management-tool",
  "version": "1.0.0",
  "private": true,
  "description": "Excel Technologies — Subscription Management Tool with Zoho Books integration",
  "author": "Hitesh (Excel Technologies)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=8.15.0"
  },
  "packageManager": "pnpm@8.15.6",
  "scripts": {
    "dev": "pnpm --parallel --filter=./apps/* dev",
    "dev:api": "pnpm --filter @subs/api dev",
    "dev:web": "pnpm --filter @subs/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @subs/db migrate",
    "db:seed": "pnpm --filter @subs/db seed",
    "db:reset": "pnpm --filter @subs/db reset",
    "db:studio": "pnpm --filter @subs/db studio",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  }
}
