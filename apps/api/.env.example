# API-specific env vars (in addition to root .env)
# Most values come from root .env via @nestjs/config — this file documents the API's needs.

DATABASE_URL="postgresql://subs_user:subs_pass@localhost:5432/subscriptions"
REDIS_URL="redis://localhost:6379"
ENCRYPTION_KEY=""

API_PORT=3001
API_BASE_URL="http://localhost:3001"
WEB_BASE_URL="http://localhost:3000"
NODE_ENV="development"
LOG_LEVEL="debug"

# Zoho Books
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REDIRECT_URI="http://localhost:3001/api/auth/zoho/callback"
ZOHO_DATA_CENTER="in"
ZOHO_API_BASE_URL="https://www.zohoapis.in/books/v3"
ZOHO_ACCOUNTS_URL="https://accounts.zoho.in"
