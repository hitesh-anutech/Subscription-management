# =====================================================================
# Subscription Management Tool — Environment Variables (Example)
# =====================================================================
# Copy to .env (or .env.local) and fill in real values for local dev.
# Each app (api, web) also has its own .env.example with app-specific
# overrides — see apps/api/.env.example and apps/web/.env.example.
# =====================================================================

# ---- Database (used by API + Prisma) ----
DATABASE_URL="postgresql://subs_user:subs_pass@localhost:5432/subscriptions"

# ---- Redis (used by API for queues + cache) ----
REDIS_URL="redis://localhost:6379"

# ---- Encryption key (32-byte base64) for OAuth tokens at rest ----
# Generate one-time with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="REPLACE_ME_WITH_32_BYTE_BASE64_KEY"

# ---- API server ----
API_PORT=3001
API_BASE_URL="http://localhost:3001"
NODE_ENV="development"

# ---- Web server ----
WEB_PORT=3000
WEB_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001/api"

# ---- Zoho Books OAuth infrastructure ----
# NOTE: Client ID और Client Secret अब Settings → Zoho App Credentials (UI) से set करो।
# नीचे values optional हैं — .env में डालो तो fallback की तरह काम करेंगे।
# Recommended: इन्हें blank रखो और UI से set करो।
ZOHO_CLIENT_ID=""
ZOHO_CLIENT_SECRET=""
ZOHO_REDIRECT_URI="http://localhost:3001/api/auth/zoho/callback"
ZOHO_DATA_CENTER="in"
ZOHO_API_BASE_URL="https://www.zohoapis.in/books/v3"
ZOHO_ACCOUNTS_URL="https://accounts.zoho.in"

# ---- Email (SendGrid) ----
# NOTE: SendGrid API key और from address अब Settings → Email Configuration (UI) से set करो।
# इन्हें यहाँ भरने की जरूरत नहीं।

# ---- Bootstrap admin user (created by seed) ----
ADMIN_EMAIL="hitesh@anutech.in"
ADMIN_NAME="Hitesh"
ADMIN_INITIAL_PASSWORD="ChangeMeFirst!2026"

# ---- Logging ----
LOG_LEVEL="debug"
