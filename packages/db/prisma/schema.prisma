// =====================================================================
// Subscription Management Tool — Prisma Schema
// =====================================================================
// Version: 1.2 (mirrors schema.sql v1.2)
// Date:    15 May 2026
// Part of: Path B — Pre-Implementation Specification Package
//
// What's new in v1.2 vs v1.0:
//   - schema.sql is the SOURCE OF TRUTH (per audit recommendation).
//   - CHECK-string columns converted to Prisma enums (Lead/Quote/
//     Subscription status, billing cycle, domain status, etc.).
//   - Auto-generated numbering fields use @default(dbgenerated(...)).
//   - Added User, Account, Session, VerificationToken models
//     (NextAuth.js compatible; fixes audit Blocker 1).
//   - Added SettingsAuditLog model (fixes audit Blocker 2).
//   - Wired user_id FK relations on Lead, QuickQuote, LeadConversion,
//     AppSettings, OrgSettings, UserPreference.
//
// Usage:
//   1. Copy this file to `prisma/schema.prisma` in your Next.js project
//   2. Set DATABASE_URL in .env
//   3. Run: npx prisma generate          (creates TypeScript types)
//   4. For DB setup, prefer:
//        psql -f schema.sql && psql -f seed_default_settings.sql
//      Then: npx prisma db pull && npx prisma generate
//
// Note: schema.sql is canonical. Some constraints (partial indexes, GIN
//       trigram indexes, full-text indexes, range CHECKs) cannot be
//       expressed in Prisma and live only in schema.sql.
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// ENUMS  (mirror schema.sql CHECK constraints)
// =====================================================================

enum DataCenter {
  in
  com
  eu
  com_au @map("com.au")
  jp
  sa
}

enum ConnectionStatus {
  active
  expired
  revoked
  error
  disconnected
}

enum ZohoCacheEntityType {
  customer
  item
}

enum LeadStatus {
  New
  Contacted
  Quoted
  Negotiating
  Won
  Converted
  Lost
  Archived
}

enum DomainStatus {
  active
  inactive
  suspended
}

enum QuoteCustomerType {
  lead
  existing
}

enum QuoteStatus {
  Draft
  Sent
  Viewed
  Accepted
  Rejected
  Expired
  Revised
  Pushed_To_Zoho
  Cancelled
}

enum BillingCycle {
  monthly
  quarterly
  half_yearly
  annual
  biennial
  triennial
  one_time
}

enum SubscriptionLifecycleStatus {
  Pending
  Active
  Expiring_Soon @map("Expiring Soon")
  Expired
  Inactive
  Cancelled
}

enum SubscriptionProcessStatus {
  None
  Renewal_Quoted   @map("Renewal Quoted")
  Renewal_Invoiced @map("Renewal Invoiced")
  Renewal_Paid     @map("Renewal Paid")
  Prorata_Quoted   @map("Pro-rata Quoted")
  Prorata_Invoiced @map("Pro-rata Invoiced")
  Prorata_Paid     @map("Pro-rata Paid")
}

enum BusinessType {
  Renewal
  ProRata @map("Pro-rata")
  Fresh
}

enum RenewalStatus {
  Quoted
  Invoiced
  Paid
  Cancelled
  Expired
}

enum LeadConversionStatus {
  pending
  success
  failed
  partial
}

enum WebhookProcessingStatus {
  pending
  processing
  success
  failed
}

enum AppSettingValueType {
  string
  number
  boolean
  json
  array
  date
}

enum PdfTemplate {
  modern
  classic
  minimal
  compact
}

enum EmailTemplateCategory {
  quote
  renewal
  pro_rata
  payment
  conversion
  lead
  admin_alert
  system
  welcome
  subscription
  customer
  notification
}

enum MasterDataListType {
  lead_source
  industry
  lost_reason
  subscription_category
  item_category
  tag
  gst_rate
  billing_cycle
  state
  country
  currency
  designation
  rejection_reason
}

enum UserRole {
  Admin
  Sales
  Manager
  Viewer
}

enum AuditAction {
  create
  update
  delete
}

enum AuditEntityType {
  app_settings
  org_settings
  email_templates
  master_data_lists
  organizations
  users
  lead
  quote
  subscription
  domain
}

enum VerificationTokenPurpose {
  email_verify
  magic_link
  password_reset
  twofa_setup @map("2fa_setup")
}

enum BugReportType {
  Bug
  Feature
  UIPolish @map("UI Polish")
}

enum BugSeverity {
  Low
  Medium
  High
  Critical
}

enum BugReportStatus {
  Open
  InProgress @map("In Progress")
  Resolved
  Closed
}

// =====================================================================
// CORE TABLES
// =====================================================================

// ---------------------------------------------------------------------
// Organization — Zoho Books org config + OAuth credentials
// ---------------------------------------------------------------------
model Organization {
  id                          String    @id @default(uuid()) @db.Uuid
  name                        String    @db.VarChar(150)
  zohoOrgId                   String    @unique @map("zoho_org_id") @db.VarChar(50)
  dataCenter                  DataCenter @default(in) @map("data_center")
  baseCurrency                String    @default("INR") @map("base_currency") @db.VarChar(10)

  accessTokenEncrypted        String?   @map("access_token_encrypted")
  refreshTokenEncrypted       String?   @map("refresh_token_encrypted")
  tokenExpiresAt              DateTime? @map("token_expires_at") @db.Timestamptz
  scopes                      String?

  connectionStatus            ConnectionStatus @default(active) @map("connection_status")
  lastSyncAt                  DateTime? @map("last_sync_at") @db.Timestamptz
  isActive                    Boolean   @default(true) @map("is_active")
  metadata                    Json      @default("{}")

  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  zohoCache                   ZohoCache[]
  zohoDocumentPdfs            ZohoDocumentPdf[]
  zohoCustomerDocs            ZohoCustomerDoc[]
  leads                       Lead[]
  domains                     Domain[]
  quickQuotes                 QuickQuote[]
  subscriptions               Subscription[]
  renewalHistory              RenewalHistory[]
  renewalBatches              RenewalBatch[]
  leadConversions             LeadConversion[]
  webhookEvents               WebhookEvent[]
  orgSettings                 OrgSettings?
  emailTemplates              EmailTemplate[]

  @@index([isActive])
  @@index([zohoOrgId])
  @@map("organizations")
}

// ---------------------------------------------------------------------
// ZohoCache — Cached Zoho customers + items for fast list views
// ---------------------------------------------------------------------
model ZohoCache {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  entityType      ZohoCacheEntityType @map("entity_type")
  zohoId          String   @map("zoho_id") @db.VarChar(80)
  displayName     String?  @map("display_name") @db.VarChar(250)
  email           String?  @db.Citext
  phone           String?  @db.VarChar(50)
  gstin           String?  @db.VarChar(30)
  extra           Json     @default("{}")
  lastSyncedAt    DateTime @default(now()) @map("last_synced_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, zohoId], name: "uq_zoho_cache_entity")
  @@index([organizationId, entityType])
  @@index([email])
  @@index([gstin])
  @@map("zoho_cache")
}

// ---------------------------------------------------------------------
// ZohoDocumentPdf — Cached PDF bytes of Zoho estimates/invoices.
// Fetched on demand from Zoho (`GET /{estimates|invoices}/{id}?accept=pdf`),
// stored so repeat "View PDF" opens cost 0 Zoho calls. Invalidated by the
// webhook path when the underlying doc changes (see WebhookService).
// ---------------------------------------------------------------------
model ZohoDocumentPdf {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  entityType      String   @map("entity_type") @db.VarChar(20)   // 'estimate' | 'invoice'
  zohoDocId       String   @map("zoho_doc_id") @db.VarChar(80)
  zohoDocNumber   String?  @map("zoho_doc_number") @db.VarChar(80)
  pdfData         Bytes    @map("pdf_data")
  byteSize        Int      @map("byte_size")
  fetchedAt       DateTime @default(now()) @map("fetched_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, zohoDocId], name: "uq_zoho_document_pdf")
  @@index([organizationId, entityType])
  @@map("zoho_document_pdf")
}

// ---------------------------------------------------------------------
// ZohoCustomerDoc — Cached Zoho quote+invoice pairs per customer.
// Populated (upserted) each time the customer's Zoho Documents panel is
// synced. Rows are never deleted on re-sync — new docs are added and
// existing ones are updated so re-visiting the page is instant.
// ---------------------------------------------------------------------
model ZohoCustomerDoc {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  zohoCustomerId  String    @map("zoho_customer_id") @db.VarChar(80)
  /// Primary key within Zoho: quoteId when paired, invoiceId for standalone invoices.
  docKey          String    @map("doc_key") @db.VarChar(80)

  quoteId         String?   @map("quote_id") @db.VarChar(80)
  quoteNumber     String?   @map("quote_number") @db.VarChar(80)
  quoteDate       String?   @map("quote_date") @db.VarChar(20)
  quoteStatus     String?   @map("quote_status") @db.VarChar(30)
  quoteTotal      Float?    @map("quote_total")

  invoiceId       String?   @map("invoice_id") @db.VarChar(80)
  invoiceNumber   String?   @map("invoice_number") @db.VarChar(80)
  invoiceDate     String?   @map("invoice_date") @db.VarChar(20)
  invoiceStatus   String?   @map("invoice_status") @db.VarChar(30)
  invoiceTotal    Float?    @map("invoice_total")

  businessType    String?   @map("business_type") @db.VarChar(50)

  syncedAt        DateTime  @default(now()) @map("synced_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lines           ZohoCustomerDocLine[]

  @@unique([organizationId, zohoCustomerId, docKey], name: "uq_zoho_customer_doc")
  @@index([organizationId, zohoCustomerId])
  @@map("zoho_customer_docs")
}

// ---------------------------------------------------------------------
// ZohoCustomerDocLine — Line items for a cached Zoho document.
// Populated on first "hover" or "Map" of a document — DB-first,
// Zoho API fallback. Subsequent hovers are instant from DB.
// ---------------------------------------------------------------------
model ZohoCustomerDocLine {
  id          String   @id @default(uuid()) @db.Uuid
  docId       String   @map("doc_id") @db.Uuid
  lineOrder   Int      @default(0) @map("line_order")
  name        String   @db.VarChar(250)
  qty         Float    @default(0)
  rate        Float    @default(0)
  domain      String?  @db.VarChar(255)
  startDate   String?  @map("start_date") @db.VarChar(20)
  endDate     String?  @map("end_date") @db.VarChar(20)

  doc         ZohoCustomerDoc @relation(fields: [docId], references: [id], onDelete: Cascade)

  @@index([docId])
  @@map("zoho_customer_doc_lines")
}

// ---------------------------------------------------------------------
// Lead — Prospects (Central App only, never pushed to Zoho until converted)
// ---------------------------------------------------------------------
model Lead {
  id                              String    @id @default(uuid()) @db.Uuid
  /// DB-generated via generate_lead_number() — format LD-YYYY-NNNN
  leadNumber                      String    @unique @default(dbgenerated("generate_lead_number()")) @map("lead_number") @db.VarChar(50)

  // Contact info
  companyName                     String    @map("company_name") @db.VarChar(250)
  contactName                     String?   @map("contact_name") @db.VarChar(200)
  email                           String    @db.Citext
  phone                           String?   @db.VarChar(50)
  designation                     String?   @db.VarChar(100)

  // Address
  billingAddressLine1             String?   @map("billing_address_line1") @db.VarChar(250)
  billingAddressLine2             String?   @map("billing_address_line2") @db.VarChar(250)
  city                            String?   @db.VarChar(100)
  state                           String?   @db.VarChar(100)
  stateCode                       String?   @map("state_code") @db.VarChar(10)
  postalCode                      String?   @map("postal_code") @db.VarChar(20)
  country                         String?   @default("India") @db.VarChar(100)

  gstin                           String?   @db.VarChar(30)
  gstTreatment                    String?   @map("gst_treatment") @db.VarChar(20)
  pan                             String?   @db.VarChar(30)

  primaryDomain                   String?   @map("primary_domain") @db.VarChar(255)
  industry                        String?   @db.VarChar(100)
  leadSource                      String?   @map("lead_source") @db.VarChar(100)

  // Lifecycle
  status                          LeadStatus @default(New)
  assignedToUserId                String?   @map("assigned_to_user_id") @db.Uuid
  estimatedCloseDate              DateTime? @map("estimated_close_date") @db.Date
  estimatedValue                  Decimal?  @map("estimated_value") @db.Decimal(12, 2)

  // Conversion tracking
  convertedToZohoCustomerId       String?   @map("converted_to_zoho_customer_id") @db.VarChar(80)
  convertedAt                     DateTime? @map("converted_at") @db.Timestamptz
  targetOrganizationId            String?   @map("target_organization_id") @db.Uuid
  lostReason                      String?   @map("lost_reason") @db.VarChar(250)

  notes                           String?
  metadata                        Json      @default("{}")
  createdAt                       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  targetOrganization              Organization?    @relation(fields: [targetOrganizationId], references: [id], onDelete: SetNull)
  assignedTo                      User?            @relation("LeadsAssignedToUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  quickQuotes                     QuickQuote[]
  subscriptions                   Subscription[]
  conversions                     LeadConversion[]

  @@index([status])
  @@index([email])
  @@index([primaryDomain])
  @@index([assignedToUserId])
  @@index([estimatedCloseDate])
  @@index([convertedToZohoCustomerId])
  @@map("leads")
}

// ---------------------------------------------------------------------
// Domain — Maps domain to Zoho customer in specific org
// ---------------------------------------------------------------------
model Domain {
  id                  String   @id @default(uuid()) @db.Uuid
  domainName          String   @map("domain_name") @db.VarChar(255)
  organizationId      String   @map("organization_id") @db.Uuid
  zohoCustomerId      String   @map("zoho_customer_id") @db.VarChar(80)
  zohoCustomerName    String?  @map("zoho_customer_name") @db.VarChar(250)
  status              DomainStatus @default(active)
  notes               String?
  metadata            Json     @default("{}")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subscriptions       Subscription[]
  renewalHistory      RenewalHistory[]

  @@unique([organizationId, zohoCustomerId, domainName], name: "uq_domain_org_customer_name", map: "uq_domain_org_customer_name")
  @@index([organizationId, zohoCustomerId])
  @@index([status])
  @@map("domains")
}

// ---------------------------------------------------------------------
// QuickQuote — Fresh sale quotes (Quote Types 1 & 2)
// ---------------------------------------------------------------------
model QuickQuote {
  id                              String    @id @default(uuid()) @db.Uuid
  /// DB-generated via generate_quote_number() — format QQ-YYYY-NNNN
  quoteNumber                     String    @unique @default(dbgenerated("generate_quote_number()")) @map("quote_number") @db.VarChar(50)

  // Customer type: 'lead' or 'existing' (mutually exclusive)
  customerType                    QuoteCustomerType @map("customer_type")
  leadId                          String?   @map("lead_id") @db.Uuid
  zohoCustomerId                  String?   @map("zoho_customer_id") @db.VarChar(80)
  zohoCustomerName                String?   @map("zoho_customer_name") @db.VarChar(250)

  targetOrganizationId            String    @map("target_organization_id") @db.Uuid

  // Quote details
  quoteDate                       DateTime  @default(now()) @map("quote_date") @db.Date
  validityDays                    Int       @default(15) @map("validity_days")
  expiryDate                      DateTime  @map("expiry_date") @db.Date

  // Pricing
  subtotal                        Decimal   @default(0) @db.Decimal(12, 2)
  discountAmount                  Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount                       Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount                     Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  currency                        String    @default("INR") @db.VarChar(10)

  // Tax breakdown (GST India)
  isIntraState                    Boolean?  @map("is_intra_state")
  cgstRate                        Decimal?  @map("cgst_rate") @db.Decimal(5, 2)
  sgstRate                        Decimal?  @map("sgst_rate") @db.Decimal(5, 2)
  igstRate                        Decimal?  @map("igst_rate") @db.Decimal(5, 2)

  // Lifecycle
  status                          QuoteStatus @default(Draft)
  sentAt                          DateTime? @map("sent_at") @db.Timestamptz
  viewedAt                        DateTime? @map("viewed_at") @db.Timestamptz
  viewCount                       Int       @default(0) @map("view_count")
  acceptedAt                      DateTime? @map("accepted_at") @db.Timestamptz
  rejectedAt                      DateTime? @map("rejected_at") @db.Timestamptz
  rejectionReason                 String?   @map("rejection_reason")

  // Public access (Lead-mode only)
  publicToken                     String?   @unique @map("public_token") @db.VarChar(128)
  publicTokenExpiresAt            DateTime? @map("public_token_expires_at") @db.Timestamptz

  // Content
  termsAndConditions              String?   @map("terms_and_conditions")
  notesToCustomer                 String?   @map("notes_to_customer")
  internalNotes                   String?   @map("internal_notes")

  // Revisions
  revisionOfQuoteId               String?   @map("revision_of_quote_id") @db.Uuid

  // Zoho integration
  zohoEstimateId                  String?   @map("zoho_estimate_id") @db.VarChar(80)
  zohoEstimateNumber              String?   @map("zoho_estimate_number") @db.VarChar(80)
  // Live status of the converted Zoho Invoice (draft/sent/paid/overdue/void), synced on demand
  zohoInvoiceStatus               String?   @map("zoho_invoice_status") @db.VarChar(30)
  pushedToZohoAt                  DateTime? @map("pushed_to_zoho_at") @db.Timestamptz
  /// User's choice at Convert time: 'create_now' | 'later' | 'never' (null = pre-feature; treated as 'later')
  subscriptionDecision            String?   @map("subscription_decision") @db.VarChar(20)

  // PDF
  pdfStoragePath                  String?   @map("pdf_storage_path")
  pdfGeneratedAt                  DateTime? @map("pdf_generated_at") @db.Timestamptz

  createdByUserId                 String?   @map("created_by_user_id") @db.Uuid
  createdAt                       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  lead                            Lead?                @relation(fields: [leadId], references: [id], onDelete: Restrict)
  targetOrganization              Organization         @relation(fields: [targetOrganizationId], references: [id], onDelete: Restrict)
  createdBy                       User?                @relation("QuotesCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  revisionOf                      QuickQuote?          @relation("QuoteRevisions", fields: [revisionOfQuoteId], references: [id], onDelete: SetNull)
  revisions                       QuickQuote[]         @relation("QuoteRevisions")
  items                           QuickQuoteItem[]
  subscriptions                   Subscription[]
  conversions                     LeadConversion[]

  @@index([leadId])
  @@index([zohoCustomerId])
  @@index([targetOrganizationId])
  @@index([status])
  @@index([publicToken])
  @@index([quoteDate(sort: Desc)])
  @@index([expiryDate])
  @@map("quick_quotes")
}

// ---------------------------------------------------------------------
// QuickQuoteItem — Line items for quick_quotes
// ---------------------------------------------------------------------
model QuickQuoteItem {
  id                      String    @id @default(uuid()) @db.Uuid
  quickQuoteId            String    @map("quick_quote_id") @db.Uuid
  lineOrder               Int       @map("line_order")

  zohoItemId              String?   @map("zoho_item_id") @db.VarChar(80)
  itemName                String    @map("item_name") @db.VarChar(250)
  itemDescription         String?   @map("item_description")
  hsnOrSac                String?   @map("hsn_or_sac") @db.VarChar(20)

  quantity                Decimal   @db.Decimal(12, 2)
  unitPrice               Decimal   @map("unit_price") @db.Decimal(12, 2)
  costPrice               Decimal?  @map("cost_price") @db.Decimal(12, 2)
  discountPercent         Decimal   @default(0) @map("discount_percent") @db.Decimal(5, 2)
  discountAmount          Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxRate                 Decimal   @default(18) @map("tax_rate") @db.Decimal(5, 2)
  lineSubtotal            Decimal   @map("line_subtotal") @db.Decimal(12, 2)
  lineTax                 Decimal   @default(0) @map("line_tax") @db.Decimal(12, 2)
  lineTotal               Decimal   @map("line_total") @db.Decimal(12, 2)

  // Subscription context (used when invoice paid → subscription created)
  isSubscription          Boolean       @default(true) @map("is_subscription")
  billingCycle            BillingCycle? @map("billing_cycle")
  serviceStartDate        DateTime? @map("service_start_date") @db.Date
  serviceEndDate          DateTime? @map("service_end_date") @db.Date
  primaryDomain           String?   @map("primary_domain") @db.VarChar(255)
  /// Bulk-domains quote line: [{domain, qty}] — one subscription per domain at convert
  domainList              Json?     @map("domain_list")

  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz

  quickQuote              QuickQuote @relation(fields: [quickQuoteId], references: [id], onDelete: Cascade)
  renewedSubscriptionId   String?       @map("renewed_subscription_id") @db.Uuid
  renewedSubscription     Subscription? @relation("SubscriptionRenewals", fields: [renewedSubscriptionId], references: [id], onDelete: SetNull)

  @@unique([quickQuoteId, lineOrder], name: "uq_qqi_quote_line_order")
  @@index([quickQuoteId])
  @@index([zohoItemId])
  @@index([renewedSubscriptionId])
  @@map("quick_quote_items")
}

// ---------------------------------------------------------------------
// Subscription — Master subscription records
// ---------------------------------------------------------------------
model Subscription {
  id                              String    @id @default(uuid()) @db.Uuid
  /// DB-generated via generate_subscription_number() — format SUB-YYYY-NNNN
  subscriptionNumber              String    @unique @default(dbgenerated("generate_subscription_number()")) @map("subscription_number") @db.VarChar(50)

  organizationId                  String    @map("organization_id") @db.Uuid
  domainId                        String    @map("domain_id") @db.Uuid

  zohoCustomerId                  String    @map("zoho_customer_id") @db.VarChar(80)
  zohoCustomerName                String?   @map("zoho_customer_name") @db.VarChar(250)
  zohoItemId                      String    @map("zoho_item_id") @db.VarChar(80)
  zohoItemName                    String?   @map("zoho_item_name") @db.VarChar(250)

  // Origin tracking
  originLeadId                    String?   @map("origin_lead_id") @db.Uuid
  originQuickQuoteId              String?   @map("origin_quick_quote_id") @db.Uuid

  // Subscription parameters
  quantity                        Decimal   @db.Decimal(12, 2)
  subscriptionPrice               Decimal   @map("subscription_price") @db.Decimal(12, 2)
  nextRenewalPrice                Decimal?  @map("next_renewal_price") @db.Decimal(12, 2)
  costPrice                       Decimal   @default(0) @map("cost_price") @db.Decimal(12, 2)
  billingCycle                    BillingCycle @map("billing_cycle")

  // Billing currency (prices above are in this currency); exchangeRate = 1 unit of
  // `currency` in the org base currency (INR) at import → base amount = amount * rate.
  currency                        String    @default("INR") @db.VarChar(10)
  exchangeRate                    Decimal   @default(1) @map("exchange_rate") @db.Decimal(16, 6)

  startDate                       DateTime  @map("start_date") @db.Date
  endDate                         DateTime  @map("end_date") @db.Date
  nextRenewalDate                 DateTime? @map("next_renewal_date") @db.Date
  autoRenew                       Boolean   @default(false) @map("auto_renew")

  // State machine
  lifecycleStatus                 SubscriptionLifecycleStatus @default(Pending) @map("lifecycle_status")
  processStatus                   SubscriptionProcessStatus   @default(None)    @map("process_status")
  businessType                    BusinessType                @default(Renewal) @map("business_type")

  // Latest Zoho snapshots
  lastQuoteId                     String?   @map("last_quote_id") @db.VarChar(80)
  lastQuoteNumber                 String?   @map("last_quote_number") @db.VarChar(80)
  lastQuoteDate                   DateTime? @map("last_quote_date") @db.Date
  lastInvoiceId                   String?   @map("last_invoice_id") @db.VarChar(80)
  lastInvoiceNumber               String?   @map("last_invoice_number") @db.VarChar(80)
  lastInvoiceDate                 DateTime? @map("last_invoice_date") @db.Date

  notes                           String?
  metadata                        Json      @default("{}")
  createdAt                       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  organization                    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain                          Domain           @relation(fields: [domainId], references: [id], onDelete: Restrict)
  originLead                      Lead?            @relation(fields: [originLeadId], references: [id], onDelete: SetNull)
  originQuickQuote                QuickQuote?      @relation(fields: [originQuickQuoteId], references: [id], onDelete: SetNull)
  renewalHistory                  RenewalHistory[]
  renewedQuoteItems               QuickQuoteItem[] @relation("SubscriptionRenewals")

  @@index([organizationId, lifecycleStatus])
  @@index([domainId])
  @@index([zohoCustomerId])
  @@index([nextRenewalDate])
  @@index([endDate])
  @@index([originLeadId])
  @@index([originQuickQuoteId])
  @@index([processStatus])
  @@map("subscriptions")
}

// ---------------------------------------------------------------------
// RenewalBatch — Tracks grouped bulk renewal quotes (Type 5)
// ---------------------------------------------------------------------
model RenewalBatch {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  
  zohoCustomerId     String    @map("zoho_customer_id") @db.VarChar(80)
  zohoCustomerName   String?   @map("zoho_customer_name") @db.VarChar(250)
  zohoItemId         String    @map("zoho_item_id") @db.VarChar(80)
  zohoItemName       String?   @map("zoho_item_name") @db.VarChar(250)
  
  billingCycle       String    @map("billing_cycle") @db.VarChar(50)
  domainCount        Int       @map("domain_count")
  unitPrice          Decimal   @map("unit_price") @db.Decimal(12, 2)
  totalAmount        Decimal   @map("total_amount") @db.Decimal(12, 2)
  
  zohoEstimateId     String?   @map("zoho_estimate_id") @db.VarChar(80)
  zohoEstimateNumber String?   @map("zoho_estimate_number") @db.VarChar(80)
  
  hasAnnexure        Boolean   @default(false) @map("has_annexure")
  annexureData       Json?     @map("annexure_data")
  
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  createdBy          String?   @map("created_by") @db.VarChar(150)

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  renewalHistories   RenewalHistory[]

  @@index([organizationId])
  @@index([zohoCustomerId])
  @@index([createdAt(sort: Desc)])
  @@map("renewal_batches")
}

// ---------------------------------------------------------------------
// CsvImportLog — Audit trail for subscriptions bulk CSV import runs
// (mirrors schema.sql `csv_import_logs`, section 13)
// ---------------------------------------------------------------------
model CsvImportLog {
  id            String   @id @default(uuid()) @db.Uuid

  importType    String   @default("subscriptions_bulk_update") @map("import_type") @db.VarChar(50)
  fileName      String?  @map("file_name") @db.VarChar(255)

  totalRows     Int      @default(0) @map("total_rows")
  updatedCount  Int      @default(0) @map("updated_count")
  createdCount  Int      @default(0) @map("created_count")
  enrichedCount Int      @default(0) @map("enriched_count")
  skippedCount  Int      @default(0) @map("skipped_count")
  errorCount    Int      @default(0) @map("error_count")

  skippedRows   Json?    @map("skipped_rows")
  errorRows     Json?    @map("error_rows")
  warningRows   Json?    @map("warning_rows")

  createdBy     String?  @map("created_by") @db.VarChar(150)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt(sort: Desc)])
  @@index([importType])
  @@map("csv_import_logs")
}

// ---------------------------------------------------------------------
// RenewalHistory — Audit trail for renewal & pro-rata events (Types 3 & 4)
// ---------------------------------------------------------------------
model RenewalHistory {
  id                      String    @id @default(uuid()) @db.Uuid
  subscriptionId          String    @map("subscription_id") @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  domainId                String    @map("domain_id") @db.Uuid

  businessType            BusinessType  @map("business_type")
  billingCycle            BillingCycle? @map("billing_cycle")

  serviceStartDate        DateTime? @map("service_start_date") @db.Date
  serviceEndDate          DateTime? @map("service_end_date") @db.Date
  quantity                Decimal?  @db.Decimal(12, 2)
  sellingPrice            Decimal?  @map("selling_price") @db.Decimal(12, 2)
  costPrice               Decimal?  @map("cost_price") @db.Decimal(12, 2)
  subtotalAmount          Decimal?  @map("subtotal_amount") @db.Decimal(12, 2)

  // Billing currency snapshot for this event (amounts above are in this currency).
  currency                String    @default("INR") @db.VarChar(10)
  exchangeRate            Decimal   @default(1) @map("exchange_rate") @db.Decimal(16, 6)

  renewalStatus           RenewalStatus @default(Quoted) @map("renewal_status")

  // Zoho Estimate (Proforma) live status synced from Zoho: draft|sent|accepted|declined|invoiced|expired
  zohoEstimateStatus      String?   @map("zoho_estimate_status") @db.VarChar(30)
  // Zoho Invoice live status synced from Zoho: draft|sent|paid|partially_paid|overdue|void
  zohoInvoiceStatus       String?   @map("zoho_invoice_status") @db.VarChar(30)
  sentAt                  DateTime? @map("sent_at") @db.Timestamptz

  quoteId                 String?   @map("quote_id") @db.VarChar(80)
  quoteNumber             String?   @map("quote_number") @db.VarChar(80)
  quoteDate               DateTime? @map("quote_date") @db.Date
  invoiceId               String?   @map("invoice_id") @db.VarChar(80)
  invoiceNumber           String?   @map("invoice_number") @db.VarChar(80)
  invoiceDate             DateTime? @map("invoice_date") @db.Date
  paymentId               String?   @map("payment_id") @db.VarChar(80)
  paymentDate             DateTime? @map("payment_date") @db.Date

  rawQuotePayload         Json?     @map("raw_quote_payload")
  rawInvoicePayload       Json?     @map("raw_invoice_payload")

  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  bulkRenewalBatchId      String?   @map("bulk_renewal_batch_id") @db.Uuid

  subscription            Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  domain                  Domain        @relation(fields: [domainId], references: [id], onDelete: Restrict)
  bulkRenewalBatch        RenewalBatch? @relation(fields: [bulkRenewalBatchId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, createdAt(sort: Desc)])
  @@index([renewalStatus])
  @@index([businessType])
  @@index([quoteId])
  @@index([invoiceId])
  @@index([organizationId])
  @@map("renewal_history")
}

// ---------------------------------------------------------------------
// LeadConversion — Audit log of lead-to-Zoho conversion attempts
// ---------------------------------------------------------------------
model LeadConversion {
  id                      String    @id @default(uuid()) @db.Uuid
  leadId                  String    @map("lead_id") @db.Uuid
  quickQuoteId            String?   @map("quick_quote_id") @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid

  zohoCustomerId          String?   @map("zoho_customer_id") @db.VarChar(80)
  zohoEstimateId          String?   @map("zoho_estimate_id") @db.VarChar(80)
  zohoEstimateNumber      String?   @map("zoho_estimate_number") @db.VarChar(80)
  subscriptionIds         String[]  @map("subscription_ids") @db.Uuid

  conversionStatus        LeadConversionStatus @map("conversion_status")
  errorMessage            String?   @map("error_message")
  zohoResponsePayload     Json?     @map("zoho_response_payload")

  convertedByUserId       String?   @map("converted_by_user_id") @db.Uuid
  convertedAt             DateTime  @default(now()) @map("converted_at") @db.Timestamptz

  lead                    Lead          @relation(fields: [leadId], references: [id], onDelete: Restrict)
  quickQuote              QuickQuote?   @relation(fields: [quickQuoteId], references: [id], onDelete: SetNull)
  organization            Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  convertedBy             User?         @relation("ConversionsConvertedByUser", fields: [convertedByUserId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([conversionStatus])
  @@index([convertedAt(sort: Desc)])
  @@map("lead_conversions")
}

// ---------------------------------------------------------------------
// WebhookEvent — Idempotent webhook event log
// ---------------------------------------------------------------------
model WebhookEvent {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String?   @map("organization_id") @db.Uuid
  eventSource         String    @default("zoho_books") @map("event_source") @db.VarChar(50)
  eventType           String?   @map("event_type") @db.VarChar(100)
  zohoEntityId        String?   @map("zoho_entity_id") @db.VarChar(80)
  eventHash           String    @unique @map("event_hash") @db.VarChar(128)
  payload             Json
  processingStatus    WebhookProcessingStatus @default(pending) @map("processing_status")
  processedAt         DateTime? @map("processed_at") @db.Timestamptz
  errorMessage        String?   @map("error_message")
  retryCount          Int       @default(0) @map("retry_count")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization        Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([processingStatus])
  @@index([organizationId, eventType])
  @@index([zohoEntityId])
  @@index([createdAt(sort: Desc)])
  @@map("webhook_events")
}

// =====================================================================
// SETTINGS TABLES
// =====================================================================

// ---------------------------------------------------------------------
// AppSettings — Global key-value settings
// ---------------------------------------------------------------------
model AppSettings {
  id                  String    @id @default(uuid()) @db.Uuid
  category            String    @db.VarChar(50)
  settingKey          String    @map("setting_key") @db.VarChar(100)
  settingValue        Json      @map("setting_value")
  valueType           AppSettingValueType @default(json) @map("value_type")
  description         String?
  isSensitive         Boolean   @default(false) @map("is_sensitive")
  isSystem            Boolean   @default(false) @map("is_system")
  updatedByUserId     String?   @map("updated_by_user_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  updatedBy           User?     @relation("AppSettingsUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([category, settingKey], name: "uq_app_settings_key")
  @@index([category])
  @@index([isSystem])
  @@map("app_settings")
}

// ---------------------------------------------------------------------
// OrgSettings — Per-organization branding & configuration
// ---------------------------------------------------------------------
model OrgSettings {
  id                              String    @id @default(uuid()) @db.Uuid
  organizationId                  String    @unique @map("organization_id") @db.Uuid

  // Branding
  legalName                       String?   @map("legal_name") @db.VarChar(250)
  displayName                     String?   @map("display_name") @db.VarChar(250)
  logoUrl                         String?   @map("logo_url")
  brandColor                      String?   @default("#1F2937") @map("brand_color") @db.VarChar(20)

  // Header info
  addressLine1                    String?   @map("address_line1") @db.VarChar(250)
  addressLine2                    String?   @map("address_line2") @db.VarChar(250)
  city                            String?   @db.VarChar(100)
  state                           String?   @db.VarChar(100)
  stateCode                       String?   @map("state_code") @db.VarChar(10)
  postalCode                      String?   @map("postal_code") @db.VarChar(20)
  country                         String?   @default("India") @db.VarChar(100)
  gstin                           String?   @db.VarChar(30)
  pan                             String?   @db.VarChar(30)
  phone                           String?   @db.VarChar(50)
  email                           String?   @db.Citext
  website                         String?   @db.VarChar(250)

  // PDF behavior
  pdfTemplate                     PdfTemplate @default(modern) @map("pdf_template")
  pdfFooterText                   String?   @map("pdf_footer_text")
  pdfShowCostPrice                Boolean   @default(false) @map("pdf_show_cost_price")
  pdfShowInternalNotes            Boolean   @default(false) @map("pdf_show_internal_notes")
  pdfWatermark                    String?   @map("pdf_watermark") @db.VarChar(50)
  signatureImageUrl               String?   @map("signature_image_url")

  // Tax defaults
  defaultTaxRate                  Decimal   @default(18) @map("default_tax_rate") @db.Decimal(5, 2)
  supplierState                   String?   @map("supplier_state") @db.VarChar(100)
  supplierStateCode               String?   @map("supplier_state_code") @db.VarChar(10)

  // Bank details
  bankName                        String?   @map("bank_name") @db.VarChar(100)
  bankAccountNumber               String?   @map("bank_account_number") @db.VarChar(50)
  bankIfsc                        String?   @map("bank_ifsc") @db.VarChar(20)
  bankAccountHolder               String?   @map("bank_account_holder") @db.VarChar(250)

  // Email overrides
  emailFromAddress                String?   @map("email_from_address") @db.Citext
  emailReplyTo                    String?   @map("email_reply_to") @db.Citext
  emailSignatureHtml              String?   @map("email_signature_html")
  smtpUser                        String?   @map("smtp_user") @db.Citext
  smtpPasswordEncrypted           String?   @map("smtp_password_encrypted")

  // Quote defaults override
  quoteValidityDays               Int?      @map("quote_validity_days")
  quoteTermsAndConditions         String?   @map("quote_terms_and_conditions")
  quoteNotesToCustomer            String?   @map("quote_notes_to_customer")

  // Per-organization numbering formats (override global formats if set)
  quoteNumberFormat               String?   @map("quote_number_format") @db.VarChar(50)
  leadNumberFormat                String?   @map("lead_number_format") @db.VarChar(50)
  subscriptionNumberFormat        String?   @map("subscription_number_format") @db.VarChar(50)

  settingsOverrides               Json      @default("{}") @map("settings_overrides")
  metadata                        Json      @default("{}")
  updatedByUserId                 String?   @map("updated_by_user_id") @db.Uuid
  createdAt                       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization                    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy                       User?        @relation("OrgSettingsUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("org_settings")
}

// ---------------------------------------------------------------------
// EmailTemplate — Editable email templates (global or per-org)
// ---------------------------------------------------------------------
model EmailTemplate {
  id                          String    @id @default(uuid()) @db.Uuid
  organizationId              String?   @map("organization_id") @db.Uuid

  templateKey                 String    @map("template_key") @db.VarChar(80)
  templateName                String    @map("template_name") @db.VarChar(200)
  category                    EmailTemplateCategory
  language                    String    @default("en") @db.VarChar(10)

  subject                     String    @db.VarChar(500)
  bodyHtml                    String    @map("body_html")
  bodyText                    String?   @map("body_text")

  availablePlaceholders       Json      @default("[]") @map("available_placeholders")

  description                 String?
  isActive                    Boolean   @default(true) @map("is_active")
  isSystem                    Boolean   @default(false) @map("is_system")

  updatedByUserId             String?   @map("updated_by_user_id") @db.Uuid
  createdAt                   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization                Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy                   User?         @relation("EmailTemplatesUpdatedByUser", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, templateKey, language], name: "uq_email_templates")
  @@index([templateKey])
  @@index([category])
  @@index([isActive])
  @@map("email_templates")
}

// ---------------------------------------------------------------------
// MasterDataList — Custom dropdown lists
// ---------------------------------------------------------------------
model MasterDataList {
  id              String             @id @default(uuid()) @db.Uuid
  listType        MasterDataListType @map("list_type")
  itemValue       String    @map("item_value") @db.VarChar(200)
  itemLabel       String?   @map("item_label") @db.VarChar(250)
  displayOrder    Int       @default(0) @map("display_order")
  isActive        Boolean   @default(true) @map("is_active")
  isSystem        Boolean   @default(false) @map("is_system")
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([listType, itemValue], name: "uq_master_data")
  @@index([listType])
  @@index([listType, isActive])
  @@index([listType, displayOrder])
  @@map("master_data_lists")
}

// ---------------------------------------------------------------------
// UserPreference — Per-user UI preferences
// ---------------------------------------------------------------------
model UserPreference {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  preferenceKey       String    @map("preference_key") @db.VarChar(100)
  preferenceValue     Json      @map("preference_value")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, preferenceKey], name: "uq_user_preferences")
  @@index([userId])
  @@map("user_preferences")
}

// =====================================================================
// AUTH & AUDIT TABLES  (NextAuth.js compatible)
// =====================================================================

// ---------------------------------------------------------------------
// User — Application user accounts
// ---------------------------------------------------------------------
model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique @db.Citext
  emailVerified       DateTime? @map("email_verified") @db.Timestamptz
  name                String?   @db.VarChar(200)
  imageUrl            String?   @map("image_url")

  // Local-password auth (NULL if OAuth-only)
  passwordHash        String?   @map("password_hash")
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz

  // RBAC (Phase 2 enforcement; MVP defaults to Admin)
  role                UserRole  @default(Admin)

  // Lifecycle
  isActive            Boolean   @default(true) @map("is_active")
  lastLoginAt         DateTime? @map("last_login_at") @db.Timestamptz
  failedLoginCount    Int       @default(0) @map("failed_login_count")
  lockedUntil         DateTime? @map("locked_until") @db.Timestamptz

  // 2FA (Phase 2)
  totpSecretEncrypted String?   @map("totp_secret_encrypted")
  totpEnabled         Boolean   @default(false) @map("totp_enabled")

  // Profile
  phone               String?   @db.VarChar(50)
  signatureHtml       String?   @map("signature_html")

  metadata            Json      @default("{}")
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Relations (named because there are multiple back-refs from same target)
  accounts                 Account[]
  sessions                 Session[]
  preferences              UserPreference[]
  leadsAssigned            Lead[]              @relation("LeadsAssignedToUser")
  quotesCreated            QuickQuote[]        @relation("QuotesCreatedByUser")
  conversionsPerformed     LeadConversion[]    @relation("ConversionsConvertedByUser")
  appSettingsUpdated       AppSettings[]       @relation("AppSettingsUpdatedByUser")
  orgSettingsUpdated       OrgSettings[]       @relation("OrgSettingsUpdatedByUser")
  emailTemplatesUpdated    EmailTemplate[]     @relation("EmailTemplatesUpdatedByUser")
  auditLogEntries          SettingsAuditLog[]
  bugReports               BugReport[]

  @@index([email])
  @@index([isActive])
  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------
// Account — OAuth provider linkage (NextAuth)
// ---------------------------------------------------------------------
model Account {
  id                       String    @id @default(uuid()) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  provider                 String    @db.VarChar(50)
  providerAccountId        String    @map("provider_account_id") @db.VarChar(255)
  type                     String    @db.VarChar(30)

  accessTokenEncrypted     String?   @map("access_token_encrypted")
  refreshTokenEncrypted    String?   @map("refresh_token_encrypted")
  expiresAt                DateTime? @map("expires_at") @db.Timestamptz
  tokenType                String?   @map("token_type") @db.VarChar(30)
  scope                    String?
  idTokenEncrypted         String?   @map("id_token_encrypted")
  sessionState             String?   @map("session_state") @db.VarChar(255)

  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId], name: "uq_accounts_provider")
  @@index([userId])
  @@map("accounts")
}

// ---------------------------------------------------------------------
// Session — Active user sessions (DB-strategy NextAuth)
// ---------------------------------------------------------------------
model Session {
  id            String    @id @default(uuid()) @db.Uuid
  sessionToken  String    @unique @map("session_token") @db.VarChar(255)
  userId        String    @map("user_id") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz
  ipAddress     String?   @map("ip_address") @db.Inet
  userAgent     String?   @map("user_agent")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ---------------------------------------------------------------------
// VerificationToken — Email verify / magic link / password reset / 2FA setup
// ---------------------------------------------------------------------
model VerificationToken {
  identifier  String                   @db.VarChar(255)
  token       String                   @db.VarChar(255)
  purpose     VerificationTokenPurpose @default(email_verify)
  expiresAt   DateTime                 @map("expires_at") @db.Timestamptz
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz

  @@id([identifier, token])
  @@index([identifier])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------
// SettingsAuditLog — Append-only audit trail (PRD §5A.1)
// ---------------------------------------------------------------------
model SettingsAuditLog {
  id                  String           @id @default(uuid()) @db.Uuid
  entityType          AuditEntityType  @map("entity_type")
  entityId            String?          @map("entity_id") @db.Uuid
  settingCategory     String?          @map("setting_category") @db.VarChar(50)
  settingKey          String?          @map("setting_key") @db.VarChar(150)

  userId              String?          @map("user_id") @db.Uuid
  userEmailSnapshot   String?          @map("user_email_snapshot") @db.VarChar(200)

  action              AuditAction
  oldValue            Json?            @map("old_value")
  newValue            Json?            @map("new_value")
  changeSummary       String?          @map("change_summary")

  ipAddress           String?          @map("ip_address") @db.Inet
  userAgent           String?          @map("user_agent")
  requestId           String?          @map("request_id") @db.Uuid

  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user                User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([userId])
  @@index([settingCategory, settingKey])
  @@index([createdAt(sort: Desc)])
  @@map("settings_audit_log")
}

// ---------------------------------------------------------------------
// BugReport — In-app feedback & bug tracking (test-mode tool)
// ---------------------------------------------------------------------
model BugReport {
  id           String          @id @default(uuid()) @db.Uuid
  bugNumber    Int             @default(autoincrement()) @map("bug_number")
  type         BugReportType   @default(Bug)
  severity     BugSeverity     @default(Medium)
  details      String          @db.Text
  pageUrl      String?         @map("page_url") @db.VarChar(500)
  screenshots  Json            @default("[]")
  status       BugReportStatus @default(Open)
  adminNote    String?         @map("admin_note") @db.Text
  reportedById String?         @map("reported_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  reportedBy   User?           @relation(fields: [reportedById], references: [id], onDelete: SetNull)

  @@unique([bugNumber])
  @@index([status])
  @@index([type, severity])
  @@index([createdAt(sort: Desc)])
  @@map("bug_reports")
}

